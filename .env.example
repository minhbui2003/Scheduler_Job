# ==============================================================================
# SCHEDULER JOB - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to `.env` for local development or paste into Vercel Environment Variables.
# DO NOT put real production credentials in this example file.
# ==============================================================================

# MongoDB Database Connection
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/scheduler_job?retryWrites=true&w=majority

# Application Base URL (Use http://localhost:3000 for local, https://your-domain.vercel.app for production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication (JWT Secrets - minimum 32 characters)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_string
REFRESH_TOKEN_SECRET=your_refresh_token_secret_minimum_32_characters_random_string

# Default Administrator Account (Bootstrap on first login)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Email Service (SMTP - Gmail App Password or custom SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_16_character_app_password
MAIL_FROM="Scheduler Job" <noreply@schedulerjob.com>

# AI Integration (Google Gemini or OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4o

# Background Cron Security Key (Used by Vercel Cron or external triggers)
CRON_SECRET=your_secure_cron_secret_token_here
